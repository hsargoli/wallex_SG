# --- App ---
PROJECT_NAME="Wallex Platform"
ENV="development"
DEBUG=True
LOG_LEVEL="INFO"

# --- Wallex Exchange ---
# برای دریافت API Key به پنل کاربری والکس مراجعه کنید
# ⚠️ هرگز API Key واقعی را در این فایل قرار ندهید
WALLEX_BASE_URL="https://api.wallex.ir"
WALLEX_WS_URL="wss://api.wallex.ir/ws"
WALLEX_API_KEY="your-api-key-here"
WALLEX_TIMEOUT_SECONDS=10
WALLEX_MAX_CONNECTIONS=20

# --- Cache ---
CACHE_TTL_SECONDS=5

# --- Security (اختیاری، برای آینده) ---
# JWT_SECRET_KEY="generate-a-random-secret-here"
# CORS_ORIGINS="http://localhost:3000,https://yourdomain.ir"
