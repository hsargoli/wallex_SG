<project_summary>
  <project>
    <name>Wallex Trading Platform</name>
    <goal>
      Build a scalable trading platform on top of Wallex.ir exchange,
      starting with an MVP that is designed for future expansion
      (smart scanners, trading bots, backtesting, multi-exchange, real-time data).
    </goal>
    <architecture_style>Modular Monolith with Ports and Adapters (Hexagonal / Clean Architecture)</architecture_style>
  </project>

  <decisions>
    <decision id="1">
      <title>Architecture Choice</title>
      <choice>Modular Monolith + Ports &amp; Adapters</choice>
      <reason>
        MVP must stay simple, but the seams of change must exist from day one
        so that future modules (multi-exchange, workers, bots, real-time)
        can be added without rewriting business logic.
      </reason>
    </decision>

    <decision id="2">
      <title>Repository Layout</title>
      <choice>Monorepo</choice>
      <structure>
        ~/wallex/
        ├── .env
        ├── .env.example
        ├── .gitignore
        ├── Makefile
        ├── docker-compose.yml
        ├── README.md
        ├── backend/
        ├── frontend/       (empty for now)
        └── docs/
      </structure>
    </decision>

    <decision id="3">
      <title>Package Manager</title>
      <choice>uv (with pyproject.toml + uv.lock)</choice>
      <reason>
        Fast, modern, reproducible. Uses uv run without manually activating venv.
      </reason>
    </decision>

    <decision id="4">
      <title>Frontend (deferred)</title>
      <choice>To be decided later (Next.js or Vite + React)</choice>
    </decision>

    <decision id="5">
      <title>Wallex Authentication</title>
      <choice>Only x-api-key header</choice>
      <note>
        WALLEX_API_SECRET does not exist for the Wallex exchange.
        It only exists for WallexPay (payment gateway) which is not our target.
      </note>
    </decision>
  </decisions>

