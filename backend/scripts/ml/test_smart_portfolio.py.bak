"""Backtest Smart Portfolio — مسیریابی بین ۴ ربات بر اساس رژیم."""

import asyncio

from app.application.use_cases.get_candles import GetCandlesUseCase
from app.core.config import get_settings
from app.infrastructure.exchange.wallex.client import WallexExchange
from app.services.regime_detector import detect_regime
from app.services.simple_bot import (
    check_simple_exit as mr_exit,
    make_simple_decision as mr_decision,
)
from app.services.bots.trend_follow.config import TrendFollowConfig
from app.services.bots.trend_follow.strategy import (
    evaluate_entry as tf_entry,
    evaluate_exit as tf_exit,
)
from app.services.bots.volatility_hunter.config import VolatilityHunterConfig
from app.services.bots.volatility_hunter.strategy import (
    evaluate_entry as vh_entry,
    evaluate_exit as vh_exit,
)

SYMBOLS = [
    "BTCTMN", "ETHTMN", "XRPTMN", "SOLTMN", "BNBTMN",
    "ADATMN", "LINKTMN", "DOGETMN", "DASHTMN", "LTCTMN",
    "ZECTMN", "GRAMTMN", "HBARTMN", "UNITMN", "ONETMN",
]
TF = "1h"
N_CANDLES = 2000
INITIAL_CAPITAL = 300_000
FEE_PCT = 0.2
REGIME_CHECK_INTERVAL = 20   # چک رژیم هر 20 کندل


async def fetch_all():
    settings = get_settings()
    async def one(sym):
        ex = WallexExchange.create(settings)
        try:
            uc = GetCandlesUseCase(exchange=ex)
            return sym, await uc.execute(symbol=sym, timeframe=TF, limit=N_CANDLES)
        except Exception:
            return sym, []
        finally:
            await ex.aclose()
    results = await asyncio.gather(*[one(s) for s in SYMBOLS])
    return {s: c for s, c in results if c}


def _get_regime(candles_slice):
    """تشخیص رژیم و برگردوندن به صورت string."""
    r = detect_regime(candles_slice)
    return r.regime.value if hasattr(r.regime, "value") else str(r.regime)


def backtest_symbol(symbol, candles, cash):
    """بک‌تست یک نماد با مسیریابی به ربات مناسب."""
    cash_initial = cash
    tf_cfg = TrendFollowConfig()
    vh_cfg = VolatilityHunterConfig()

    peak = cash
    max_dd = 0
    trades = []
    open_pos = None  # dict: entry, sl, tp, invest, bot

    current_regime = "unknown"

    for idx in range(100, len(candles)):
        candle = candles[idx]
        window = candles[: idx + 1]
        price = float(candle.close)

        # equity calculation for DD
        equity = cash + (open_pos["invest"] * price / open_pos["entry"] if open_pos else 0)
        if equity > peak: peak = equity
        dd = (peak - equity) / peak * 100 if peak > 0 else 0
        if dd > max_dd: max_dd = dd

        # ---------- تشخیص رژیم هر 20 کندل ----------
        if idx % REGIME_CHECK_INTERVAL == 0:
            current_regime = _get_regime(window)

        # ---------- چک خروج ----------
        if open_pos is not None:
            exit_p = None
            reason = ""
            bot = open_pos["bot"]

            if bot == "mean_revert":
                should_exit, exit_p, reason = mr_exit(
                    open_pos["entry"], open_pos["tp"], open_pos["sl"],
                    candle, idx - open_pos["entry_idx"],
                )
            elif bot == "trend_follow":
                # trend_follow: فقط SL و Trailing
                trailing_dist = open_pos.get("trailing_distance") or (open_pos["entry"] * 0.03)
                tx = tf_exit(
                    window,
                    open_pos["entry"],
                    open_pos["sl"],
                    trailing_dist,
                    tf_cfg,
                    idx - open_pos["entry_idx"],
                )
                should_exit = tx.should_exit
                reason = tx.reason or ""
                exit_p = open_pos["sl"] if should_exit else 0.0
                if tx.new_sl is not None and tx.new_sl > open_pos["sl"]:
                    open_pos["sl"] = tx.new_sl
            elif bot == "volatility_hunter":
                should_exit, exit_p, reason = vh_exit(
                    window, open_pos["entry"], open_pos["sl"],
                    open_pos["tp"], vh_cfg,
                )

            if should_exit:
                pnl = (exit_p / open_pos["entry"] - 1) * 100 - FEE_PCT
                cash += open_pos["invest"] * pnl / 100
                trades.append({
                    "symbol": symbol,
                    "pnl": pnl,
                    "reason": reason,
                    "bot": bot,
                    "regime": current_regime,
                })
                open_pos = None
                continue

        # ---------- چک ورود بر اساس رژیم ----------
        if open_pos is not None:
            continue
        if idx < 100:
            continue

        signal = None
        bot_name = None

        if current_regime == "trending_up":
            sig = tf_entry(window, tf_cfg)
            if sig and sig.should_enter:
                signal = {
                    "entry": sig.entry_price,
                    "tp": 0,  # trailing
                    "sl": sig.initial_sl,
                    "trailing_distance": sig.trailing_distance,
                }
                bot_name = "trend_follow"

        elif current_regime == "ranging":
            # کف‌زن (اولویت اول)
            dec = mr_decision(window)
            if dec.should_trade:
                signal = {
                    "entry": dec.entry_price,
                    "tp": dec.take_profit,
                    "sl": dec.stop_loss,
                }
                bot_name = "mean_revert"

        elif current_regime == "choppy":
            sig = vh_entry(window, vh_cfg)
            if sig and sig.should_trade:
                signal = {
                    "entry": sig.entry_price,
                    "tp": sig.take_profit,
                    "sl": sig.stop_loss,
                }
                bot_name = "volatility_hunter"

        # trending_down → هیچ ورودی

        if signal is None:
            continue

        invest = cash * 0.3
        if invest < 5000:
            continue

        open_pos = {
            "entry": signal["entry"],
            "tp": signal["tp"],
            "sl": signal["sl"],
            "invest": invest,
            "entry_idx": idx,
            "bot": bot_name,
            "trailing_distance": signal.get("trailing_distance"),
        }

    # بستن باز
    if open_pos:
        price = float(candles[-1].close)
        pnl = (price / open_pos["entry"] - 1) * 100 - FEE_PCT
        cash += open_pos["invest"] * pnl / 100
        trades.append({
            "symbol": symbol,
            "pnl": pnl,
            "reason": "end",
            "bot": open_pos["bot"],
            "regime": current_regime,
        })

    return {
        "symbol": symbol,
        "initial": cash_initial,
        "final": cash,
        "trades": trades,
        "max_dd": max_dd,
    }


async def main():
    print(f"📥 دریافت {len(SYMBOLS)} نماد...\n")
    data = await fetch_all()
    print(f"✅ {len(data)} نماد\n")

    per_symbol = INITIAL_CAPITAL / len(data)

    print(f"{'='*90}")
    print(f"📊 Smart Portfolio Backtest")
    print(f"{'='*90}")

    total_final = 0
    all_trades = []
    worst_dd = 0
    by_bot = {}

    print(f"\n  {'symbol':<10} {'بازده':>9} {'ترید':>5} {'DD':>7} {'رژیم غالب'}")
    print(f"  {'─'*60}")

    for sym, candles in data.items():
        r = backtest_symbol(sym, candles, per_symbol)
        total_final += r["final"]
        all_trades.extend(r["trades"])
        worst_dd = max(worst_dd, r["max_dd"])

        ret = (r["final"] / r["initial"] - 1) * 100
        emoji = "🟢" if ret > 0 else "🔴"

        # رژیم غالب
        regimes = [t["regime"] for t in r["trades"]]
        from collections import Counter
        dominant = Counter(regimes).most_common(1)[0][0] if regimes else "—"

        print(f"  {emoji} {sym:<8} {ret:>+8.2f}% {len(r['trades']):>5} {r['max_dd']:>6.2f}% {dominant}")

        # جمع per-bot
        for t in r["trades"]:
            b = t["bot"]
            if b not in by_bot:
                by_bot[b] = {"trades": 0, "wins": 0, "pnl": 0}
            by_bot[b]["trades"] += 1
            if t["pnl"] > 0:
                by_bot[b]["wins"] += 1
            by_bot[b]["pnl"] += t["pnl"]

    # نتایج کل
    wins = sum(1 for t in all_trades if t["pnl"] > 0)
    wr = wins / len(all_trades) * 100 if all_trades else 0
    ret = (total_final / INITIAL_CAPITAL - 1) * 100
    rdd = ret / worst_dd if worst_dd > 0 else 0

    print(f"\n{'='*90}")
    print(f"🎯 نتیجه کل:")
    print(f"{'='*90}")
    print(f"  بازده:        {ret:>+9.2f}%")
    print(f"  سرمایه نهایی: {total_final:>11,.0f}")
    print(f"  Max DD:       {worst_dd:>9.2f}%")
    print(f"  R/DD:         {rdd:>9.2f}")
    print(f"  ترید:         {len(all_trades)}")
    print(f"  برد/باخت:     {wins} / {len(all_trades)-wins}")
    print(f"  WR:           {wr:>9.1f}%")

    # per-bot
    print(f"\n  📊 per-bot performance:")
    print(f"  {'bot':<22} {'ترید':>5} {'WR':>7} {'pnl کل':>9}")
    print(f"  {'─'*50}")
    for bot, st in sorted(by_bot.items(), key=lambda x: -x[1]["pnl"]):
        bot_wr = st["wins"] / st["trades"] * 100 if st["trades"] else 0
        emoji = "🟢" if st["pnl"] > 0 else "🔴"
        print(f"  {emoji} {bot:<20} {st['trades']:>5} {bot_wr:>6.1f}% {st['pnl']:>+8.2f}%")


if __name__ == "__main__":
    asyncio.run(main())
